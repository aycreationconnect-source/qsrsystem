generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Category {
  id            Int        @id @default(autoincrement())
  name          String     @unique
  description   String?
  status        String     @default("Active")
  subcategories String?
  menuItems     MenuItem[]
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  price       Float
  tax         Float?
  sku         String?
  prepTime    Int?
  isAvailable Boolean  @default(true)
  type        String   @default("Veg")
  status      String   @default("Active")
  isAddon     Boolean  @default(false)
  addonIds    String?
  subcategory String?
  useGlobalTax Boolean  @default(true)
  
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  
  ingredients RecipeIngredient[]
  orderItems  OrderItem[]
  taxes       ItemTax[]
}

model ItemTax {
  id         Int      @id @default(autoincrement())
  name       String
  rate       Float
  
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model Addon {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
}

model InventoryCategory {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  items       InventoryItem[]
}

model InventoryItem {
  id           Int                @id @default(autoincrement())
  name         String
  unit         String             // kg, L, pcs
  stock        Float
  threshold    Float
  status       String             @default("Good")
  categoryName String?            @default("General")
  
  categoryId   Int?
  category     InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  usedIn       RecipeIngredient[]
  history      InventoryHistory[]
}

model RecipeIngredient {
  id          Int           @id @default(autoincrement())
  quantity    Float
  
  menuItemId  Int
  menuItem    MenuItem      @relation(fields: [menuItemId], references: [id])
  
  inventoryId Int
  inventory   InventoryItem @relation(fields: [inventoryId], references: [id])
}

model InventoryHistory {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  change      String   // e.g. "-1.5" or "+10"
  type        String   // e.g. "Order: Burger x2" or "Restock"
  
  inventoryId Int
  inventory   InventoryItem @relation(fields: [inventoryId], references: [id])
}

model Order {
  id            Int            @id @default(autoincrement())
  date          DateTime       @default(now())
  paymentMethod String         // Cash, Card, UPI, Split
  subtotal      Float
  tax           Float
  total         Float
  paidAmount    Float          @default(0)
  balanceAmount Float          @default(0)
  status        String         @default("Completed")
  description   String?        @db.Text
  
  items         OrderItem[]
  payments      OrderPayment[]
}

model OrderPayment {
  id            Int      @id @default(autoincrement())
  amount        Float
  paymentMethod String   // Cash, Card, UPI
  reference     String?
  date          DateTime @default(now())
  
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  quantity   Int
  price      Float    // price at time of order
  
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id])
  
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model Area {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  color       String?
  tables      Table[]
}

model Table {
  id          Int      @id @default(autoincrement())
  name        String
  seats       Int      @default(4)
  status      String   @default("Available")
  
  areaId      Int
  area        Area     @relation(fields: [areaId], references: [id])
}
model Setting {
  key   String @id
  value String
}

model StoreProfile {
  id             String    @id
  cafeCode       String    @unique
  businessName   String
  ownerName      String
  phone          String
  email          String?
  city           String    @default("Mumbai")
  state          String    @default("Maharashtra")
  address        String?
  gstin          String?
  currencySymbol String    @default("₹")
  receiptFooter  String?   @default("Thank you for visiting! Please visit again.")
  logoUrl        String?   @db.Text
  isActivated    Boolean   @default(false)
  activatedAt    DateTime?
  updatedAt      DateTime  @updatedAt
}

model LocalLicense {
  id             String   @id
  licenseKey     String   @db.Text
  planCode       String
  durationDays   Int
  issuedAt       DateTime
  expiresAt      DateTime
  maxTerminals   Int      @default(10)
  allowedModules Json
  status         String   @default("ACTIVE")
  lastKnownClock DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LocalUser {
  id           String   @id
  username     String   @unique
  fullName     String
  pinCodeHash  String
  passwordHash String?
  role         String   @default("CASHIER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

